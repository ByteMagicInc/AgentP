#!/usr/bin/env bash
set -euo pipefail

CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
if [[ ! -x "$CARGO_HOME/bin/rustup" ]] || [[ ! -f "$CARGO_HOME/env" ]]; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
fi
source "$CARGO_HOME/env"
cargo fetch --locked
